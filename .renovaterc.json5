{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "config:best-practices"
  ],
  "customManagers": [
    {
      // Keep the pinned cargo tool versions and checksums in sync with their
      // GitHub releases. The computed digest is the release's `sha256.sum`.
      "customType": "regex",
      "description": "cargo tools in hack/install-cargo-tool.sh",
      "managerFilePatterns": ["/^hack\\/install-cargo-tool\\.sh$/"],
      "matchStrings": [
        "package_name=\"(?<packageName>[^\"]+)\"\\n\\s*version=\"(?<currentValue>[^\"]+)\"\\n\\s*manifest_sha256=\"(?<currentDigest>[a-f0-9]{64})\"",
      ],
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "semver",
    },
  ],
  "packageRules": [
    // Bundle opentelemetry dependencies in a single update
    {
      "matchPackageNames": [
        "opentelemetry",
        "opentelemetry-otlp",
        "opentelemetry_sdk",
        "opentelemetry-resource-detectors",
        "opentelemetry-semantic-conventions",
        "tracing-opentelemetry",
      ],
      "groupName": "opentelemetry"
    },
    // Don't pin digest in inspircd image tag
    {
      "matchManagers": ["docker-compose"],
      "matchPackageNames": ["inspircd/inspircd-docker"],
      "versioning": "semver",
      "pinDigests": false
    },
    // Don't pin official GitHub Actions versions
    {
      "matchDepTypes": ["action"],
      "matchPackageNames": ["actions/*", "mkroman/send-irc-notification"],
      "pinDigests": false,
    },
    // Don't pin the images used in the Dockerfile
    {
      "matchDatasources": ["docker"],
      "pinDigests": false
    },
    // Group the cargo tool updates in hack/install-cargo-tool.sh
    {
      "matchDatasources": ["github-release-attachments"],
      "groupName": "cargo tools"
    }
  ]
}
