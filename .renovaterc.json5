{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "config:best-practices"
  ],
  "constraints": {
    "mise": "v2026.11.8"
  },
  "lockFileMaintenance": {
    enabled: false
  },
  "packageRules": [
    // Bundle opentelemetry dependencies in a single update
    {
      "matchPackageNames": [
        "opentelemetry",
        "opentelemetry-otlp",
        "opentelemetry_sdk",
        "opentelemetry-resource-detectors",
        "opentelemetry-semantic-conventions",
        "tracing-opentelemetry",
      ],
      "groupName": "opentelemetry"
    },
    // Don't pin digest in inspircd image tag
    {
      "matchManagers": ["docker-compose"],
      "matchPackageNames": ["inspircd/inspircd-docker"],
      "versioning": "semver",
      "pinDigests": false
    },
    // Don't pin official GitHub Actions versions
    {
      "matchDepTypes": ["action"],
      "matchPackageNames": ["actions/*", "mkroman/send-irc-notification"],
      "pinDigests": false,
    },
    // Don't pin the images used in the Dockerfile
    {
      "matchDatasources": ["docker"],
      "pinDigests": false
    },
    // Group pinned CI tool updates managed by mise
    {
      "matchManagers": ["mise"],
      "groupName": "pinned CI tools",
      "minimumReleaseAge": "7 days"
    },
    // Group the mise CLI version across workflows, the Dockerfile, and tool constraints
    {
      "matchPackageNames": ["jdx/mise", "ghcr.io/jdx/mise", "mise"],
      "groupName": "mise CLI"
    },
    // Group Docker build tool updates in mise.docker.toml
    {
      "matchFileNames": ["mise.docker.toml"],
      "groupName": "docker build tools",
      "minimumReleaseAge": "7 days"
    },
    // AWS publishes one aggregate daily release for all SDK crates, so link
    // each crate to the matching release or the SDK changelog.
    {
      "description": "Link AWS SDK Rust crates to the corresponding aws-sdk-rust release or changelog",
      "matchDatasources": ["crate"],
      "matchPackageNames": [
        "/^aws-(sdk-|config$|credential-types$|runtime$|runtime-api$|sigv4$|types$|smithy-)/"
      ],
      "changelogUrl": "{{#if (and (containsString depName \"aws-sdk-\") releaseTimestamp)}}https://github.com/awslabs/aws-sdk-rust/releases/tag/release-{{lookup (split releaseTimestamp \"T\") 0}}{{else}}https://github.com/awslabs/aws-sdk-rust/blob/main/CHANGELOG.md{{/if}}",
      "fetchChangeLogs": "off"
    }
  ]
}
